# syntax=docker/dockerfile:1
FROM node:20-alpine AS base

RUN apk add --no-cache libc6-compat
WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# --- Builder Stage ---
FROM base AS builder
WORKDIR /app

# Copy root workspace configurations
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./

# Copy package manifests across workspace to guarantee frozen lockfile integrity
COPY packages/config/package.json ./packages/config/
COPY packages/shared/package.json ./packages/shared/
COPY packages/database/package.json ./packages/database/
COPY packages/auth/package.json ./packages/auth/
COPY packages/ui/package.json ./packages/ui/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY apps/web/package.json ./apps/web/
COPY apps/api/package.json ./apps/api/
COPY apps/discord-bot/package.json ./apps/discord-bot/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy sources
COPY packages/config ./packages/config
COPY packages/shared ./packages/shared
COPY packages/ui ./packages/ui
COPY packages/eslint-config ./packages/eslint-config
COPY apps/web ./apps/web

# Optional build arg for API URL
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL

# Build web application and its dependencies via Turborepo
RUN pnpm turbo run build --filter=@claimboard/web...

# --- Production Web Runner (Nginx) ---
FROM nginx:alpine AS runner

# Remove default nginx configs and interfering entrypoint scripts
RUN rm -rf /etc/nginx/conf.d/* /docker-entrypoint.d/*

# Copy built static assets
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Copy dynamic multi-port entrypoint script
COPY docker/entrypoint-web.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80
EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]

