# syntax=docker/dockerfile:1
FROM node:20-alpine AS base

# Install libc compatibility for Alpine
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Enable pnpm via corepack
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# --- Builder Stage ---
FROM base AS builder
WORKDIR /app

# Copy root workspace configurations
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./

# Copy package manifests for optimal docker layer caching
COPY packages/config/package.json ./packages/config/
COPY packages/shared/package.json ./packages/shared/
COPY packages/database/package.json ./packages/database/
COPY packages/auth/package.json ./packages/auth/
COPY apps/discord-bot/package.json ./apps/discord-bot/

# Install all workspace dependencies
RUN pnpm install --frozen-lockfile

# Copy package source files
COPY packages/config ./packages/config
COPY packages/shared ./packages/shared
COPY packages/database ./packages/database
COPY packages/auth ./packages/auth
COPY apps/discord-bot ./apps/discord-bot

# Build dependencies and discord-bot service
RUN pnpm --filter @claimboard/config build
RUN pnpm --filter @claimboard/shared build
RUN pnpm --filter @claimboard/database build
RUN pnpm --filter @claimboard/auth build
RUN pnpm --filter @claimboard/discord-bot build

# --- Runner Stage ---
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

# Install pnpm for running workspace binaries if needed
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# Don't run as root for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 claimboard

# Copy built artifacts and node_modules from builder
COPY --from=builder --chown=claimboard:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=claimboard:nodejs /app/package.json ./package.json
COPY --from=builder --chown=claimboard:nodejs /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=builder --chown=claimboard:nodejs /app/packages ./packages
COPY --from=builder --chown=claimboard:nodejs /app/apps/discord-bot ./apps/discord-bot

USER claimboard

# Start production Discord bot
CMD ["node", "apps/discord-bot/dist/index.js"]

